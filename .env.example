# Copy to .env (git-ignored). Everything is optional; the app runs with none of it.
# `agentrylab run` and `agentrylab serve` both load .env automatically.

# ---------------------------------------------------------------- lab (presets)
# OPENAI_API_KEY=sk-...            # presets that use the OpenAI provider
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434
# APIFY_API_TOKEN=apify_...        # marketplace_deals preset
# WOLFRAM_APP_ID=...               # Wolfram Alpha tool

# ---------------------------------------------------------------- room: public stage brain
# AGENTRYLAB_ROOM_PROVIDER=auto    # auto | openai | ollama | mock  (auto = openai if key set, else mock)
# AGENTRYLAB_ROOM_MODEL=gpt-4o-mini
# AGENTRYLAB_MOCK_LATENCY=1.1      # seconds of fake "thinking" in demo mode

# ---------------------------------------------------------------- room: storage
# AGENTRYLAB_ROOM_OUTPUTS=outputs                  # base dir for the two below
# AGENTRYLAB_ROOM_TRANSCRIPTS=outputs/transcripts  # room-<id>.jsonl
# AGENTRYLAB_ROOM_DB=outputs/room.db               # users, sessions, encrypted keys

# ---------------------------------------------------------------- room: accounts & security
# AGENTRYLAB_ALLOW_SIGNUP=1        # 0 to close registration
# AGENTRYLAB_COOKIE_SECURE=1       # set when serving behind HTTPS / a TLS proxy
# AGENTRYLAB_SCRYPT_N=16384        # password-hash cost; 2^14 ≈ 30 ms and 16 MiB

# ---------------------------------------------------------------- room: UI
# AGENTRYLAB_WEB_DIST=web/dist     # built frontend, auto-detected in a checkout
